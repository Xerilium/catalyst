{
  "name": "@xerilium/catalyst",
  "version": "0.2.10-dev",
  "description": "Catalyst AI is an execution framework for building scalable apps.",
  "author": "Xerilium <hello@xerilium.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/xerilium/catalyst#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/xerilium/catalyst.git"
  },
  "bugs": {
    "url": "https://github.com/xerilium/catalyst/issues"
  },
  "keywords": [
    "agent",
    "agentic",
    "ai",
    "automation",
    "catalyst",
    "foundry",
    "framework",
    "fx",
    "multiagent",
    "xe",
    "xerilium"
  ],
  "bin": {
    "catalyst": "./bin/catalyst.js",
    "catalyst-github": "./bin/catalyst-github.js"
  },
  "files": [
    "ai",
    "ai-config",
    "ai-providers",
    "cli",
    "core",
    "playbooks",
    "resources",
    "standards",
    "templates",
    "traceability",
    "bin",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "cli": "node bin/catalyst.js",
    "build": "tsx scripts/build.ts",
    "release": "tsx scripts/release.ts",
    "patch": "tsx scripts/bump-patch.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:install": "cd tests && npm install --save-dev ../dist/catalyst-latest.tgz",
    "traceability": "tsx scripts/run-traceability.ts",
    "validate-spec": "tsx scripts/validate-spec.ts --all"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@xerilium/catalyst": "file:dist/catalyst-latest.tgz",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-json-schema": "^0.67.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/generative-ai": "^0.24.1",
    "ajv": "^8.20.0",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "js-yaml": "^4.3.0",
    "jse-eval": "^1.5.2",
    "ollama": "^0.6.3",
    "openai": "^6.49.0",
    "picocolors": "^1.1.1"
  }
}
